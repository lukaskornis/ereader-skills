#!/bin/sh /etc/rc.common
# Claude chat relay for the e-readers (port 8787). Key files and sessions live in /etc/claudechat.

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/claudechat
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
